#usda 1.0
(
    defaultPrim = "cube_30mm_yellow"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "cube_30mm_yellow" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float physics:mass = 0.012407034

    def Mesh "geometry" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.015, -0.015, -0.015), (0.015, 0.015, 0.015)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [19, 11, 3, 0, 16, 8, 22, 14, 6, 12, 20, 4, 7, 15, 23, 18, 2, 10, 17, 1, 9, 5, 21, 13, 4, 6, 5, 5, 6, 7, 0, 1, 2, 2, 1, 3, 11, 2, 3, 10, 2, 11, 19, 1, 17, 3, 1, 19, 7, 6, 15, 6, 14, 15, 10, 11, 15, 15, 14, 10, 22, 6, 4, 4, 20, 22, 16, 20, 12, 12, 8, 16, 23, 19, 17, 17, 21, 23, 23, 5, 7, 23, 21, 5, 23, 15, 11, 11, 19, 23, 0, 2, 18, 18, 16, 0, 18, 22, 20, 18, 20, 16, 10, 14, 18, 14, 22, 18, 9, 1, 0, 0, 8, 9, 4, 5, 13, 13, 12, 4, 8, 12, 13, 13, 9, 8, 13, 21, 17, 17, 9, 13]
        rel material:binding = </cube_30mm_yellow/Looks/pla_cube_30mm_yellow>
        rel material:binding:physics = </cube_30mm_yellow/Looks/physics_pla> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(-0.015, -0.014, -0.014), (-0.015, -0.014, 0.014), (-0.015, 0.014, -0.014), (-0.015, 0.014, 0.014), (0.015, -0.014, -0.014), (0.015, -0.014, 0.014), (0.015, 0.014, -0.014), (0.015, 0.014, 0.014), (-0.014, -0.015, -0.014), (-0.014, -0.015, 0.014), (-0.014, 0.015, -0.014), (-0.014, 0.015, 0.014), (0.014, -0.015, -0.014), (0.014, -0.015, 0.014), (0.014, 0.015, -0.014), (0.014, 0.015, 0.014), (-0.014, -0.014, -0.015), (-0.014, -0.014, 0.015), (-0.014, 0.014, -0.015), (-0.014, 0.014, 0.015), (0.014, -0.014, -0.015), (0.014, -0.014, 0.015), (0.014, 0.014, -0.015), (0.014, 0.014, 0.015)]
        color3f[] primvars:displayColor = [(0.95, 0.8, 0.05)]
        uniform token subdivisionScheme = "none"
    }

    def "Looks"
    {
        def Material "pla_cube_30mm_yellow"
        {
            token outputs:surface.connect = </cube_30mm_yellow/Looks/pla_cube_30mm_yellow/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.8, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }

        def Material "physics_pla" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.8
        }
    }
}

